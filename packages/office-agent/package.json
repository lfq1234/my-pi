{
  "name": "@earendil-works/pi-office-agent",
  "version": "0.1.0",
  "description": "Office agent skeleton built on the shared pi core engine.",
  "type": "module",
  "bin": {
    "office": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "start": "node dist/cli.js --help",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-client": "0.84.2",
    "@earendil-works/pi-protocol": "0.84.2",
    "@earendil-works/pi-telemetry": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "shx": "0.4.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "office-agent",
    "agent",
    "office",
    "document",
    "workspace"
  ],
  "author": "Earendil Works",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
