{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "paths": {
      "@earendil-works/pi-agent-core": [
        "../agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-agent-core/*": [
        "../agent/dist/*.d.ts"
      ],
      "@earendil-works/pi-ai": [
        "../ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai/*": [
        "../ai/dist/*.d.ts",
        "../ai/dist/providers/*.d.ts"
      ],
      "@earendil-works/pi-client": [
        "../client/dist/index.d.ts"
      ],
      "@earendil-works/pi-client/*": [
        "../client/dist/*.d.ts"
      ],
      "@earendil-works/pi-protocol": [
        "../protocol/dist/index.d.ts"
      ],
      "@earendil-works/pi-protocol/*": [
        "../protocol/dist/*.d.ts"
      ],
      "@earendil-works/pi-telemetry": [
        "../telemetry/dist/index.d.ts"
      ],
      "@earendil-works/pi-telemetry/*": [
        "../telemetry/dist/*.d.ts"
      ],
      "@earendil-works/pi-tui": [
        "../tui/dist/index.d.ts"
      ],
      "@earendil-works/pi-tui/*": [
        "../tui/dist/*.d.ts",
        "../tui/dist/components/*.d.ts"
      ],
      "@earendil-works/pi-coding-agent": [
        "../coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-coding-agent/client": [
        "../coding-agent/dist/client/index.d.ts"
      ],
      "@earendil-works/pi-coding-agent/*": [
        "../coding-agent/dist/*.d.ts"
      ],
      "@earendil-works/pi-server": [
        "../server/dist/index.d.ts"
      ],
      "@earendil-works/pi-server/*": [
        "../server/dist/*.d.ts"
      ],
      "@earendil-works/pi-server/unix": [
        "../server/dist/transports/unix/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
